rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite acceso a usuarios autenticados (incluye autenticación anónima)
    // La pantalla de login con usuario/contraseña protege el acceso a la app.

    match /estudios/{docId} {
      allow read, write: if request.auth != null;
    }

    match /pet_unam/{docId} {
      allow read, write: if request.auth != null;
    }

    // Bloquear todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
